# Server-side key for the free tier (/api/chat). Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: overflow provider used when Groq's free quota is used up.
# Note: Google may use free-tier prompts to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: fair-use guard per visitor per day (0 = off). Defaults: 25 questions, 100 helper calls.
DAILY_QUESTIONS_PER_IP=
DAILY_HELPER_CALLS_PER_IP=

# Optional: shared store for the guard's counts. Without these, counts are kept in memory.
# Works with Upstash Redis or Vercel KV (which sets KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
