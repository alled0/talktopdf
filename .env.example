# Server-side key used by the free tier (/api/chat). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: persistent per-IP daily limits. Without these, limits are kept in memory (best effort).
# Works with Upstash Redis or Vercel KV (which sets KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
