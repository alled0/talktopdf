{
  "name": "talktopdf",
  "private": true,
  "version": "0.1.0",
  "description": "Chat with your PDFs and get answers that cite the exact page. Hybrid search runs in the browser; answers come from Groq through a Vercel function.",
  "homepage": "https://talktopdf-omega.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alled0/talktopdf.git"
  },
  "license": "MIT",
  "author": "Alwaleed Almutairi (https://github.com/alled0)",
  "keywords": ["rag", "pdf", "semantic-search", "bm25", "groq", "react", "vite", "transformers-js"],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "eval": "node scripts/eval.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0"
  }
}
